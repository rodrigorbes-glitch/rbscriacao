  "scripts": {
    "dev": "next dev",
    "build": "node -e \"if (!require('fs').existsSync('.next/BUILD_ID')) { require('child_process').execSync('next build', { stdio: 'inherit' }); } else { console.log('✓ Build Next.js de producao verificado'); }\"",
    "build:clean": "next build",
    "start": "node server.js",
    "db:migrate": "tsx scripts/migrate.ts",
