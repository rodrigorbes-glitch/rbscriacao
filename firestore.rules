rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // FUNÇÕES GERAIS DE SEGURANÇA
    // Verifica se o usuário que está fazendo a ação está na lista de e-mails permitidos
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'rodrigorbes@gmail.com' ||
        request.auth.token.email == 'dra.rachelbeatriz@gmail.com'
      );
    }

    // NÍVEL 1: VITRINE PÚBLICA (Qualquer um lê, só Admin altera)
    match /produtos/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /configuracoes/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // NÍVEL 2: CAIXA DE CORREIO SEGURA (Anti-Ataques)
    match /pedidos/{document} {
      // Admin pode ver a lista inteira, alterar status e apagar se quiser.
      allow read, update, delete: if isAdmin();
      
      // Público SÓ PODE CRIAR novos pedidos com status 'pendente'
      allow create: if true 
                    && request.resource.data.keys().hasAny(['status', 'cliente_nome'])
                    && request.resource.data.status == 'pendente';

      // O frontend (não-admin) pode atualizar pedidos para mudar status de pagamento
      // (ex: pendente -> pago, ou adicionar transacao_id)
      allow update: if (request.auth != null && request.auth.uid == resource.data.user_id) || 
                       request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status', 'transacao_id', 'updatedAt']);
    }

    // NÍVEL 3: COFRE DO ADMIN (Só quem está logado lê ou altera)
    match /transacoes/{document} {
      allow read, write: if isAdmin();
    }
    match /clientes/{document} {
      allow read, write: if isAdmin();
    }
    match /distribuidores/{document} {
      allow read, write: if isAdmin();
    }
    match /consignacoes/{document} {
      allow read, write: if isAdmin();
    }
    
    // PROTEÇÃO PADRÃO: Qualquer outra coleção não mapeada aqui ficará trancada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
